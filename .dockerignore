# Version control
.git/
.gitignore

# Virtual environments
.venv/
.venv-dvc/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Datasets and large data directories (managed by DVC/bind mount)
data/raw/*
!data/raw/*.dvc
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/*.dvc
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# DVC internal cache and temporary files
.dvc/cache/
.dvc/tmp/
.dvc/*.local

# Trained models and serialized artifacts (managed by DVC/bind mount)
models/*.pkl
models/*.keras
!models/.gitkeep

# MLflow tracking local database and artifacts
mlflow.db
mlruns/

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key

# IDE and editor settings
.idea/
.vscode/
.gemini/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Documentation build output
site/
