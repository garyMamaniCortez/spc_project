# ==============================================================================
# VARIABLES DE ENTORNO — SPC PROJECT (.env.example)
# Copia este archivo a '.env' y completa con tus valores reales:
#   cp .env.example .env
# ==============================================================================

# --- DVC: Almacenamiento Remoto de Datos y Modelos ---
# Nombre del remote por defecto en DVC (ej: gdrive_remote, s3_remote, local_storage)
DVC_REMOTE_NAME=gdrive_remote

# URL o ID de la carpeta remota:
# - Para Google Drive: gdrive://<ID_DE_TU_CARPETA_EN_GOOGLE_DRIVE>
# - Para AWS S3: s3://<NOMBRE_DE_TU_BUCKET>/spc_project
# - Para carpeta local/red: /ruta/absoluta/almacenamiento_dvc
DVC_REMOTE_URL=gdrive://15Cr7Ru_-oGrf_Yjdp5pyBQihUq_Aq4wR

# --- Credenciales de Google Cloud / Google Drive (Opcional si usas Service Account) ---
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
# GDRIVE_CREDENTIALS_DATA=

# --- Credenciales de AWS S3 (Opcional si usas S3) ---
# AWS_ACCESS_KEY_ID=tu_access_key
# AWS_SECRET_ACCESS_KEY=tu_secret_key
# AWS_DEFAULT_REGION=us-east-1

# --- MLflow: Configuración de Tracking ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=salary-classification

# --- Configuración del Proyecto y Rutas ---
PYTHONPATH=/app
PYTHONUNBUFFERED=1
RAW_DATA_PATH=data/raw/salary.csv
